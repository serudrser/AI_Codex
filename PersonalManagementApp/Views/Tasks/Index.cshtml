@model IReadOnlyCollection<TaskItem>
@{
    ViewData["Title"] = "Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Tasks</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Task</a>
</div>

<table class="table table-striped table-hover bg-white shadow-sm">
    <thead>
        <tr><th>Title</th><th>Category</th><th>Due Date</th><th>Priority</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Category</td>
                <td>@(task.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td class="priority-@task.Priority.ToString().ToLowerInvariant()">@task.Priority</td>
                <td>@(task.IsCompleted ? "Completed" : "Open")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@task.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@task.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
