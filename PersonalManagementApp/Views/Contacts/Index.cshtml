@model IReadOnlyCollection<Contact>
@{
    ViewData["Title"] = "Contacts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Contacts</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Contact</a>
</div>

<table class="table table-striped table-hover bg-white shadow-sm">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var contact in Model)
        {
            <tr>
                <td>@contact.FullName</td>
                <td>@(contact.Email ?? "-")</td>
                <td>@(contact.PhoneNumber ?? "-")</td>
                <td>@(contact.Company ?? "-")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@contact.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@contact.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
